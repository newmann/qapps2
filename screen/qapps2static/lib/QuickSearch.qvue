<!-- This software is in the public domain under CC0 1.0 Universal plus a Grant of Patent License. -->
<template>
    <q-input v-if="searchPath" class="qapps2-quick-search" :dark="$q.dark.isActive" dense outlined name="queryString"
             v-model="queryString" @keydown.enter.prevent="goSearch()">
        <template v-slot:append><q-btn dense flat type="submit" name="submitButton" icon="search" @click="goSearch()"></q-btn></template>
        <q-tooltip>{{l10n('Search or Lookup by ID')}}</q-tooltip>
    </q-input>
</template>
<script>
module.exports = {
    data: function() { return { queryString:'' } },
    methods: {
        l10n: function(key) { return (window.moqui && moqui.l10n) ? moqui.l10n(key) : key; },
        goSearch: function() {
            var url = this.searchPath + "?queryString=" + encodeURIComponent(this.queryString);
            this.$root.setUrl(url);
        }
    },
    computed: {
        searchPath: function() {
            var navMenuList = this.$root.navMenuList;
            if (!navMenuList || navMenuList.length < 2) return null;
            var curAppSubscreens = navMenuList[1].subscreens;
            if (!curAppSubscreens) return null;
            for (var i = 0; i < curAppSubscreens.length; i++) {
                var curSs = curAppSubscreens[i];
                if (curSs && curSs.name === 'QuickSearch') return curSs.path;
            }
            return null;
        }
    }
};
</script>
