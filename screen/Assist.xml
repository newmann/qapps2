<?xml version="1.0" encoding="UTF-8"?>
<!--
qapps2 overlay of tools Assist.xml. Shared /apps/assist path:
  /qapps  requests .qvue  -> tools Assist.qvue (Vue 2)
  /qapps2 requests .qvue2 -> this component's Assist.qvue (Vue 3)
Do not edit tools Assist sources from here.
-->
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Assist" menu-image="fa fa-comments" menu-image-type="icon"
        render-modes="vue,qvue,qvue2" server-static="vue,qvue,qvue2">

    <pre-actions><script><![CDATA[
        // Full-page script injection is owned by qapps.xml / qapps2.xml.
        // SPA navigation loads OpenUI from Assist.qvue (path differs per shell).
    ]]></script></pre-actions>

    <transition name="setTitle" method="post">
        <parameter name="conversationId" required="true"/>
        <parameter name="title"/>
        <actions>
            <if condition="!ec.user.hasPermission('LlmGateway')">
                <return error="true" message="User does not have permission to use Assist"/></if>
            <script><![CDATA[
            def conv = ec.llm.getConversation(conversationId)
            if (conv != null && title) conv.setTitle(title)
            ec.web.sendJsonResponse([conversationId: conversationId, title: title])
            ]]></script>
        </actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <if condition="!ec.user.hasPermission('LlmGateway')">
            <return error="true" message="User does not have permission to use Assist"/></if>
    </actions>
    <widgets>
        <render-mode>
            <text type="qvue" location="component://tools/screen/Assist.qvue" template="false"/>
            <text type="qvue2" location="component://qapps2/screen/Assist.qvue" template="false"/>
            <text type="html,vuet"><![CDATA[
                <p><strong>Only supported under /qapps or /qapps2 (Quasar UI). Open the same path under /qapps/assist or /qapps2/assist.</strong></p>
            ]]></text>
        </render-mode>
    </widgets>
</screen>
