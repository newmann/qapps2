<?xml version="1.0" encoding="UTF-8"?>
<moqui-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/moqui-conf-3.xsd">
    <screen-facade>
        <screen location="component://webroot/screen/webroot.xml" default-subscreen="qapps2">
            <subscreens-item name="Login" menu-include="false"
                    location="component://qapps2/screen/Login.xml"/>
            <subscreens-item name="qapps2" menu-include="false"
                    location="component://qapps2/screen/qapps2.xml"/>
            <subscreens-item name="qapps2static" menu-include="false"
                    location="component://qapps2/screen/qapps2static.xml"/>
        </screen>
        <!-- Overlay tools Assist: .qvue stays tools (Vue2); .qvue2 uses qapps2 Assist.qvue (Vue3). -->
        <screen location="component://webroot/screen/webroot/apps.xml">
            <subscreens-item name="assist" menu-title="Assist" menu-index="97"
                    location="component://qapps2/screen/Assist.xml"/>
            <subscreens-item name="dashboardKit" menu-title="Dashboard Kit" menu-index="98"
                    location="component://qapps2/screen/DashboardKit.xml"/>
        </screen>

        <screen-text-output type="qvt2" mime-type="text/html" always-standalone="true"
                macro-template-location="component://qapps2/template/screen-macro/DefaultScreenMacros.qvt2.ftl"/>
        <screen-text-output type="qjs2" mime-type="application/javascript" always-standalone="true"
                macro-template-location="component://qapps2/template/screen-macro/DefaultScreenMacros.plain.ftl"/>
        <screen-text-output type="qvue2" mime-type="text/html" always-standalone="true"
                macro-template-location="component://qapps2/template/screen-macro/DefaultScreenMacros.plain.ftl"/>
    </screen-facade>
</moqui-conf>
